# Normalize line endings to LF in the repository regardless of which OS
# checks a file out. This keeps `git status` clean whether you're on native
# Windows, macOS, Linux, or the dev container.
* text=auto eol=lf

# Committed generated files. linguist-generated collapses them by default in
# GitHub review and keeps them out of language stats, while leaving `git diff`
# fully textual — deliberately not `-diff`, which would hide the content from
# review and reduce a staleness failure to "binary files differ". Never
# hand-merge these: resolve any conflict by re-running `make docs-index` /
# `make generate-caps`.
internal/docssearch/index.gen.go linguist-generated=true
web/src/docs-index.gen.ts linguist-generated=true
internal/capabilities/all.gen.go linguist-generated=true

# Known binaries checked into the repo (compat suite helpers) — never run
# text normalization or diff them as text.
capgen -text -diff
stub-report -text -diff
compat/suites/cli/runner -text -diff
compat/suites/go-sdk/runner -text -diff
