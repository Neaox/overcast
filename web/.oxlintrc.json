// oxlint is the ONLY linter for web/ — see https://github.com/overcast-sh/overcast/issues/1330.
// `pnpm run lint` is `oxlint .`; there is no ESLint in the repo any more (#1330
// step 3). This file is the whole gate.
//
// The rule set was derived, in #1368, from what `eslint --print-config <a .tsx
// file>` resolved at the time: the same on/off set, the same severities, and the
// four option payloads we set by hand carried over verbatim. Nothing outside this
// file contributes a rule.
//
// Mapping conventions inherited from that derivation (they explain the rule
// names below, and the `// eslint-disable-next-line <name>` suppressions in src/,
// which oxlint honours under the *ESLint* spelling):
//   `@typescript-eslint/x`  -> `typescript/x`
//   `react-hooks/x`         -> `react/x`      (oxlint ships the React Compiler
//                                              rules under the react plugin)
//   `react-refresh/only-export-components` -> `react/only-export-components`
//   `classnames/x`, `@tanstack/query/x` -> JS plugins, same rule names
//
// ---- Why ESLint could be deleted outright, with nothing lost ---------------
//
// #1368 left ESLint running four rules and recorded the first as an accepted
// loss. Re-examined for step 3, all four turn out to enforce nothing:
//
//   react-hooks/component-hook-factories — supposedly THE remainder ("flags
//     components and hooks defined inside other functions"). It is unreachable
//     in eslint-plugin-react-hooks 7.0.1. The rule only reports diagnostics of
//     `ErrorCategory.Factories`, which the React Compiler emits solely from
//     `validateNoDynamicallyCreatedComponentsOrHooks`; that pass is gated on
//     `environment.validateNoDynamicallyCreatedComponentsOrHooks`, which
//     defaults to `false` and is NOT among the flags the plugin's own
//     `COMPILER_OPTIONS.environment` turns on. Forcing it on via rule options
//     does not help either: the pass raises the diagnostic with
//     `CompilerError.throwDiagnostic`, `findFunctionsToCompile` does not catch
//     it, and the plugin's `catch (err) {}` around `transformFromAstSync`
//     swallows the throw — so the file yields *no* diagnostics at all. Measured
//     both ways against a hook-factory/nested-component fixture: zero reports.
//     Its nested-component half is in any case covered natively by
//     `react/static-components` below, which does report on that fixture.
//   react-hooks/config, react-hooks/gating — validate eslint-plugin-react-hooks'
//     own config objects; meaningless outside that plugin.
//   no-octal — octal literals are a syntax error in ESM/strict mode.
//
// The rule can be hosted here if upstream ever fixes it: oxlint's JS-plugin host
// loads `eslint-plugin-react-hooks` fine (verified — aliased under a
// non-reserved namespace, `react-hooks` itself is reserved, it reports through
// oxc's parser with no typescript-estree involved). It is deliberately NOT
// hosted, because it would re-run the Babel-based React Compiler over every file
// in JS for a rule that cannot fire: 5.4 s -> 24.4 s for the full lint, a 4.5x
// cost for zero findings. No oxc issue requests a native implementation as of
// 2026-08-23 (oxc#20791 is the nearest, and is about eslint-plugin-react-x);
// revisit if one lands, or if React fixes the rule.
//
// Deleting ESLint is also what unblocks TypeScript 7 (#1259): ESLint's parser
// chain died at *module load* under TS 7 (`@typescript-eslint/typescript-estree`
// throwing `Cannot read properties of undefined (reading 'Cjs')`), regardless of
// which rules were enabled. Nothing in web/ depends on typescript-estree now.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // `plugins` REPLACES the default set (typescript + unicorn + oxc). Only the
  // two whose rules we actually enable are listed, so a plugin's own defaults
  // can never quietly add a finding nobody chose.
  "plugins": ["typescript", "react"],

  // Nothing on by category — every rule below is enabled explicitly. Adding a
  // category here would enable rules this project has never opted into.
  "categories": {
    "correctness": "off"
  },

  "options": {
    // The type-aware rules (no-floating-promises, no-misused-promises,
    // no-unnecessary-condition, no-unnecessary-type-assertion,
    // consistent-type-imports) run through `oxlint-tsgolint`, which embeds its
    // own typescript-go — it does not read the `typescript` devDependency, so it
    // was unaffected by the TypeScript 7 bump (#1259) either way. Set here, not
    // as a CLI flag, so the editor extension and `pnpm run lint` agree and
    // neither can forget it. `options.typeAware` is only honoured in
    // the *root* config file, which is why .vscode/settings.json pins
    // `oxc.configPath` (oxc#19937).
    "typeAware": true,

    // `warn`, matching the severity ESLint's flat config gave it before oxlint
    // took it over. oxlint is now the only tool that can judge a suppression
    // comment, so without this a stale `// eslint-disable-next-line` would sit
    // in src/ forever.
    "reportUnusedDisableDirectives": "warn"
  },

  // ESLint v9 config API-compatible plugins, run through oxlint's JS-plugin
  // host (oxc's parser, no ESLint). Aliased so the rule names stay
  // byte-identical to the ESLint ones (suppression comments and docs keep
  // reading the same).
  "jsPlugins": [
    {
      "name": "classnames",
      "specifier": "./eslint-plugin-classnames/index.js"
    },
    {
      "name": "@tanstack/query",
      "specifier": "@tanstack/eslint-plugin-query"
    }
  ],

  // `dist` is build output. The plain-JS exclusions are inherited from the
  // ESLint config this replaced, which scoped its only config object to
  // `**/*.{ts,tsx}` — so .js/.mjs/.cjs files (vite.config, prettier config, the
  // local classnames plugin) have never been linted here and are not started on
  // now. oxlint would lint them by default.
  "ignorePatterns": ["dist", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"],

  "env": {
    "browser": true,
    "es2024": true
  },

  "rules": {
    // ---- eslint core (js.configs.recommended, @eslint/js v10) ------------
    "for-direction": "error",
    "no-array-constructor": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-dupe-else-if": "error",
    "no-duplicate-case": "error",
    "no-empty": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-fallthrough": "error",
    "no-global-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    // Added to js.configs.recommended by @eslint/js v10 (#1261).
    "no-unassigned-vars": "error",
    "no-unexpected-multiline": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-expressions": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-useless-assignment": "error",
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "preserve-caught-error": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",

    // oxlint's `no-unused-vars` is TypeScript-aware, so it stands in for
    // `@typescript-eslint/no-unused-vars` (same for no-array-constructor and
    // no-unused-expressions above). Options carried over verbatim.
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],

    // ---- provenance: typescript-eslint recommendedTypeChecked ------------
    // Five of these need type information (no-floating-promises,
    // no-misused-promises, no-unnecessary-condition,
    // no-unnecessary-type-assertion, consistent-type-imports); `options.typeAware`
    // above is what makes them run.
    "typescript/await-thenable": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/unbound-method": "error",

    // Hand-set option payloads, carried verbatim from the ESLint config.
    "typescript/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "arguments": false, "attributes": false, "properties": false } }
    ],
    "typescript/no-unnecessary-condition": ["warn", { "allowConstantLoopConditions": true }],
    "typescript/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],

    // Deliberately off (they were off under ESLint too). Spelled out rather than
    // omitted so the intent survives a future `categories` change.
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-base-to-string": "off",

    // ---- React Compiler rules (eslint-plugin-react-hooks v7 recommended) --
    "react/error-boundaries": "error",
    "react/exhaustive-deps": "warn",
    "react/globals": "error",
    "react/immutability": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/rules-of-hooks": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "warn",
    "react/use-memo": "error",
    // Off because of TanStack Virtual, which the rule cannot see through; it was
    // off under ESLint for the same reason.
    "react/incompatible-library": "off",

    // ---- react-refresh ----------------------------------------------------
    // `allowConstantExport` comes from reactRefresh.configs.vite; oxlint
    // defaults it to false, so it has to be spelled out here.
    "react/only-export-components": ["error", { "allowConstantExport": true }],

    // ---- local plugin: web/eslint-plugin-classnames (JS plugin) -----------
    "classnames/no-template-literal": "warn",
    "classnames/no-concatenation": "warn",
    "classnames/no-bare-ternary": "warn",
    "classnames/no-redundant-cn": "warn",
    "classnames/no-dup-ternary": "warn",
    "classnames/prefer-cva": "warn",
    "classnames/no-local-detail-row": "warn",
    "classnames/prefer-button-busy": "warn",
    "classnames/no-raw-spinner-in-content": "warn",
    "classnames/prefer-shared-formatter": "warn",
    "classnames/prefer-use-resource-mutation": "warn",
    "classnames/no-duplicate-class-cluster": "warn",

    // ---- @tanstack/eslint-plugin-query (JS plugin) ------------------------
    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/infinite-query-property-order": "error",
    "@tanstack/query/mutation-property-order": "error",
    "@tanstack/query/no-rest-destructuring": "warn",
    "@tanstack/query/no-unstable-deps": "error",
    "@tanstack/query/no-void-query-fn": "error",
    "@tanstack/query/prefer-query-options": "warn",
    "@tanstack/query/stable-query-client": "error"
  },

  "overrides": [
    {
      // TanStack Router route files export `Route` alongside components.
      "files": ["src/routes/**/*.tsx"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      // Test helpers export render utilities from one module on purpose.
      "files": ["src/test/**/*.tsx"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
