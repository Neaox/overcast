{
  "version": 1,
  "service": "sqs",
  "client": {
    "sdkId": "SQS",
    "endpointPrefix": "sqs",
    "signingName": "sqs",
    "protocol": "awsJson1_0",
    "apiVersion": "2012-11-05",
    "targetPrefix": "AmazonSQS",
    "awsQueryCompatible": true
  },
  "groups": [
    {
      "name": "sqs-gen-queue",
      "kind": "lifecycle",
      "setup": [
        {
          "op": "CreateQueue",
          "params": {
            "QueueName": {
              "$name": "dlq"
            }
          },
          "export": {
            "dlq.url": "$.QueueUrl"
          }
        },
        {
          "op": "GetQueueAttributes",
          "params": {
            "AttributeNames": [
              "QueueArn"
            ],
            "QueueUrl": {
              "$ref": "dlq.url"
            }
          },
          "export": {
            "dlq.arn": "$.Attributes.QueueArn"
          }
        }
      ],
      "tests": [
        {
          "name": "CreateQueue",
          "op": "CreateQueue",
          "call": {
            "op": "CreateQueue",
            "params": {
              "Attributes": {
                "RedrivePolicy": {
                  "$concat": [
                    "{\"deadLetterTargetArn\":\"",
                    {
                      "$ref": "dlq.arn"
                    },
                    "\",\"maxReceiveCount\":\"5\"}"
                  ]
                },
                "VisibilityTimeout": "30"
              },
              "QueueName": {
                "$name": "q"
              }
            },
            "export": {
              "queue.url": "$.QueueUrl"
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.QueueUrl": {
                  "nonEmpty": true
                }
              }
            },
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "GetQueueAttributes",
                  "params": {
                    "AttributeNames": [
                      "QueueArn"
                    ],
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  },
                  "export": {
                    "queue.arn": "$.Attributes.QueueArn"
                  }
                },
                "checks": {
                  "$.Attributes.QueueArn": {
                    "nonEmpty": true
                  }
                }
              }
            },
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "GetQueueAttributes",
                  "params": {
                    "AttributeNames": [
                      "All"
                    ],
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  }
                },
                "checks": {
                  "$.Attributes.QueueArn": {
                    "equals": {
                      "$ref": "queue.arn"
                    }
                  },
                  "$.Attributes.VisibilityTimeout": {
                    "equals": "30"
                  }
                }
              }
            },
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "listContains",
                "call": {
                  "op": "ListQueues",
                  "params": {
                    "QueueNamePrefix": {
                      "$name": "q"
                    }
                  }
                },
                "itemsPath": "$.QueueUrls",
                "where": {
                  "$": {
                    "$ref": "queue.url"
                  }
                }
              }
            }
          ]
        },
        {
          "name": "GetQueueAttributes",
          "op": "GetQueueAttributes",
          "call": {
            "op": "GetQueueAttributes",
            "params": {
              "AttributeNames": [
                "All"
              ],
              "QueueUrl": {
                "$ref": "queue.url"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.Attributes.QueueArn": {
                  "equals": {
                    "$ref": "queue.arn"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "GetQueueUrl",
          "op": "GetQueueUrl",
          "call": {
            "op": "GetQueueUrl",
            "params": {
              "QueueName": {
                "$name": "q"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.QueueUrl": {
                  "equals": {
                    "$ref": "queue.url"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "SetQueueAttributes",
          "op": "SetQueueAttributes",
          "call": {
            "op": "SetQueueAttributes",
            "params": {
              "Attributes": {
                "VisibilityTimeout": "60"
              },
              "QueueUrl": {
                "$ref": "queue.url"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "GetQueueAttributes",
                  "params": {
                    "AttributeNames": [
                      "All"
                    ],
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  }
                },
                "checks": {
                  "$.Attributes.VisibilityTimeout": {
                    "equals": "60"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "TagQueue",
          "op": "TagQueue",
          "call": {
            "op": "TagQueue",
            "params": {
              "QueueUrl": {
                "$ref": "queue.url"
              },
              "Tags": {
                "compat": "scenario"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "ListQueueTags",
                  "params": {
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  }
                },
                "checks": {
                  "$.Tags.compat": {
                    "equals": "scenario"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "ListQueueTags",
          "op": "ListQueueTags",
          "call": {
            "op": "ListQueueTags",
            "params": {
              "QueueUrl": {
                "$ref": "queue.url"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.Tags.compat": {
                  "equals": "scenario"
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "UntagQueue",
          "op": "UntagQueue",
          "call": {
            "op": "UntagQueue",
            "params": {
              "QueueUrl": {
                "$ref": "queue.url"
              },
              "TagKeys": [
                "compat"
              ]
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "ListQueueTags",
                  "params": {
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  }
                },
                "checks": {
                  "$.Tags.compat": {
                    "missing": true
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "ListDeadLetterSourceQueues",
          "op": "ListDeadLetterSourceQueues",
          "call": {
            "op": "ListDeadLetterSourceQueues",
            "params": {
              "QueueUrl": {
                "$ref": "dlq.url"
              }
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.queueUrls",
              "where": {
                "$": {
                  "$ref": "queue.url"
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "StartMessageMoveTask",
          "op": "StartMessageMoveTask",
          "call": {
            "op": "StartMessageMoveTask",
            "params": {
              "DestinationArn": {
                "$ref": "queue.arn"
              },
              "SourceArn": {
                "$ref": "dlq.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.TaskHandle": {
                  "nonEmpty": true
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "SendMessageBeforePurge",
          "op": "SendMessage",
          "call": {
            "op": "SendMessage",
            "params": {
              "MessageBody": "compat scenario message before purge",
              "QueueUrl": {
                "$ref": "queue.url"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.MessageId": {
                  "nonEmpty": true
                }
              }
            },
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "GetQueueAttributes",
                  "params": {
                    "AttributeNames": [
                      "ApproximateNumberOfMessages"
                    ],
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  }
                },
                "checks": {
                  "$.Attributes.ApproximateNumberOfMessages": {
                    "equals": "1"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "PurgeQueue",
          "op": "PurgeQueue",
          "call": {
            "op": "PurgeQueue",
            "params": {
              "QueueUrl": {
                "$ref": "queue.url"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 12,
              "delayMs": 5000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "GetQueueAttributes",
                  "params": {
                    "AttributeNames": [
                      "ApproximateNumberOfMessages",
                      "ApproximateNumberOfMessagesNotVisible"
                    ],
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  }
                },
                "checks": {
                  "$.Attributes.ApproximateNumberOfMessages": {
                    "equals": "0"
                  },
                  "$.Attributes.ApproximateNumberOfMessagesNotVisible": {
                    "equals": "0"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "ListQueues",
          "op": "ListQueues",
          "call": {
            "op": "ListQueues",
            "params": {
              "QueueNamePrefix": {
                "$name": "q"
              }
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.QueueUrls",
              "where": {
                "$": {
                  "$ref": "queue.url"
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        },
        {
          "name": "DeleteQueue",
          "op": "DeleteQueue",
          "call": {
            "op": "DeleteQueue",
            "params": {
              "QueueUrl": {
                "$ref": "queue.url"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 30,
              "delayMs": 2000,
              "assert": {
                "kind": "absent",
                "call": {
                  "op": "GetQueueAttributes",
                  "params": {
                    "AttributeNames": [
                      "All"
                    ],
                    "QueueUrl": {
                      "$ref": "queue.url"
                    }
                  }
                },
                "error": {
                  "shape": "QueueDoesNotExist",
                  "code": "AWS.SimpleQueueService.NonExistentQueue"
                }
              }
            }
          ],
          "depends": [
            "CreateQueue"
          ]
        }
      ],
      "teardown": [
        {
          "op": "DeleteQueue",
          "params": {
            "QueueUrl": {
              "$ref": "queue.url"
            }
          }
        },
        {
          "op": "DeleteQueue",
          "params": {
            "QueueUrl": {
              "$ref": "dlq.url"
            }
          }
        }
      ]
    },
