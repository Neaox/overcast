          "call": {
            "op": "SetTopicAttributes",
            "params": {
              "AttributeName": "DisplayName",
              "AttributeValue": "compat scenario topic, updated",
              "TopicArn": {
                "$ref": "topic.id"
              }
            }
          },
          "assert": [
            {
              "kind": "readback",
              "call": {
                "op": "GetTopicAttributes",
                "params": {
                  "TopicArn": {
                    "$ref": "topic.id"
                  }
                }
              },
              "checks": {
                "$.Attributes.DisplayName": {
