        {
          "name": "Publish",
          "op": "Publish",
          "call": {
            "op": "Publish",
            "params": {
              "Message": "compat scenario message",
              "Subject": "compat scenario",
              "TopicArn": {
                "$ref": "topic.id"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.MessageId": {
                  "matches": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          ],
          "depends": [
            "CreateTopic"
          ]
        },
        {
          "name": "PublishBatch",
          "op": "PublishBatch",
          "call": {
            "op": "PublishBatch",
            "params": {
              "PublishBatchRequestEntries": [
                {
                  "Id": "1",
                  "Message": "compat scenario batch message 1",
                  "Subject": "compat scenario 1"
                },
                {
                  "Id": "2",
                  "Message": "compat scenario batch message 2",
                  "Subject": "compat scenario 2"
                }
              ],
              "TopicArn": {
                "$ref": "topic.id"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.Successful[0].Id": {
                  "equals": "1"
                },
                "$.Successful[0].MessageId": {
                  "matches": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "$.Successful[1].Id": {
                  "equals": "2"
                }
              }
            },
            {
              "kind": "absent",
              "itemsPath": "$.Failed",
              "where": {
                "$.Id": "1"
              }
            }
          ],
          "depends": [
            "CreateTopic"
          ]
        },
        {
          "name": "ConfirmSubscription",
          "op": "ConfirmSubscription",
          "call": {
            "op": "ConfirmSubscription",
            "params": {
              "Token": "compat-scenario-token-that-sns-never-issued",
              "TopicArn": {
                "$ref": "topic.id"
              }
