            {
              "kind": "responseField",
              "checks": {
                "$.Attributes.SubscriptionArn": {
                  "equals": {
                    "$ref": "subscription.id"
                  }
                }
              }
            }
          ],
          "depends": [
            "Subscribe"
          ]
        },
        {
          "name": "SetSubscriptionAttributes",
          "op": "SetSubscriptionAttributes",
          "call": {
            "op": "SetSubscriptionAttributes",
            "params": {
              "AttributeName": "FilterPolicy",
              "AttributeValue": "{\"compat\":[\"scenario\",\"updated\"]}",
              "SubscriptionArn": {
                "$ref": "subscription.id"
              }
            }
          },
          "assert": [
            {
              "kind": "readback",
              "call": {
                "op": "GetSubscriptionAttributes",
                "params": {
                  "SubscriptionArn": {
                    "$ref": "subscription.id"
                  }
                }
              },
              "checks": {
                "$.Attributes.FilterPolicy": {
                  "equals": "{\"compat\":[\"scenario\",\"updated\"]}"
                }
              }
            }
          ],
          "depends": [
            "Subscribe"
          ]
        },
        {
          "name": "GetTopicAttributesAfterCreate",
          "op": "GetTopicAttributes",
          "call": {
            "op": "GetTopicAttributes",
            "params": {
              "TopicArn": {
                "$ref": "topic.id"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.Attributes.DisplayName": {
                  "equals": "compat scenario topic"
                },
                "$.Attributes.TopicArn": {
                  "equals": {
                    "$ref": "topic.id"
                  }
                }
              }
            }
          ]
        },
        {
          "name": "ListSubscriptionsByTopic",
          "op": "ListSubscriptionsByTopic",
          "call": {
            "op": "ListSubscriptionsByTopic",
            "params": {
              "TopicArn": {
                "$ref": "topic.id"
              }
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.Subscriptions",
              "where": {
                "$.Protocol": "email",
                "$.TopicArn": {
                  "$ref": "topic.id"
