          "call": {
            "op": "TagResource",
            "params": {
              "ResourceArn": {
                "$ref": "topic.id"
              },
              "Tags": [
                {
                  "Key": "compat",
                  "Value": "scenario"
                }
              ]
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "call": {
                "op": "ListTagsForResource",
                "params": {
                  "ResourceArn": {
                    "$ref": "topic.id"
                  }
                }
              },
              "itemsPath": "$.Tags",
              "where": {
                "$.Key": "compat",
                "$.Value": "scenario"
              }
            }
          ],
          "depends": [
            "CreateTopic"
          ]
        },
        {
          "name": "ListTagsForResource",
          "op": "ListTagsForResource",
          "call": {
            "op": "ListTagsForResource",
            "params": {
              "ResourceArn": {
                "$ref": "topic.id"
              }
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.Tags",
              "where": {
                "$.Key": "compat",
                "$.Value": "scenario"
              }
            }
          ],
          "depends": [
            "CreateTopic"
          ]
