  "groups": [
    {
      "name": "sns-gen-topic",
      "kind": "lifecycle",
      "setup": [],
      "tests": [
        {
          "name": "CreateTopic",
          "op": "CreateTopic",
          "call": {
            "op": "CreateTopic",
            "params": {
              "Attributes": {
                "DisplayName": "compat scenario topic"
              },
              "Name": {
                "$name": "t"
              }
            },
            "export": {
              "topic.id": "$.TopicArn"
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.TopicArn": {
                  "nonEmpty": true
                }
              }
            },
            {
              "kind": "readback",
              "call": {
                "op": "GetTopicAttributes",
                "params": {
                  "TopicArn": {
                    "$ref": "topic.id"
                  }
                }
              },
              "checks": {
                "$.Attributes.TopicArn": {
                  "equals": {
                    "$ref": "topic.id"
                  }
                }
              }
            },
            {
              "kind": "listContains",
              "call": {
                "op": "ListTopics",
                "params": {}
              },
              "itemsPath": "$.Topics",
              "where": {
                "$.TopicArn": {
                  "$ref": "topic.id"
                }
              }
            }
          ]
        },
        {
          "name": "GetTopicAttributes",
          "op": "GetTopicAttributes",
          "call": {
            "op": "GetTopicAttributes",
            "params": {
              "TopicArn": {
                "$ref": "topic.id"
              }
            }
