          "assert": [
            {
              "kind": "absent",
              "call": {
                "op": "ListTagsForResource",
                "params": {
                  "ResourceArn": {
                    "$ref": "topic.id"
                  }
                }
              },
              "itemsPath": "$.Tags",
              "where": {
                "$.Key": "compat"
              }
            }
