        {
          "name": "Subscribe",
          "op": "Subscribe",
          "call": {
            "op": "Subscribe",
            "params": {
              "Attributes": {
                "FilterPolicy": "{\"compat\":[\"scenario\"]}"
              },
              "Endpoint": {
                "$concat": [
                  {
                    "$name": "s"
                  },
                  "@example.com"
                ]
              },
              "Protocol": "email",
              "ReturnSubscriptionArn": true,
              "TopicArn": {
                "$ref": "topic.id"
              }
            },
            "export": {
              "subscription.id": "$.SubscriptionArn"
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.SubscriptionArn": {
                  "nonEmpty": true
                }
              }
            },
            {
              "kind": "readback",
              "call": {
                "op": "GetSubscriptionAttributes",
                "params": {
                  "SubscriptionArn": {
