          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.Subscriptions",
              "where": {
                "$.Protocol": "email",
                "$.TopicArn": {
                  "$ref": "topic.id"
                }
              }
            }
          ]
        },
        {
          "name": "Unsubscribe",
          "op": "Unsubscribe",
          "call": {
            "op": "Unsubscribe",
            "params": {
              "SubscriptionArn": {
                "$ref": "subscription.id"
              }
            }
          },
          "assert": [
            {
              "kind": "absent",
              "call": {
                "op": "GetSubscriptionAttributes",
                "params": {
                  "SubscriptionArn": {
                    "$ref": "subscription.id"
                  }
                }
