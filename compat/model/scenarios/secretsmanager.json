{
  "version": 1,
  "service": "secretsmanager",
  "client": {
    "sdkId": "Secrets Manager",
    "endpointPrefix": "secretsmanager",
    "signingName": "secretsmanager",
    "protocol": "awsJson1_1",
    "apiVersion": "2017-10-17",
    "targetPrefix": "secretsmanager",
    "awsQueryCompatible": false
  },
  "groups": [
    {
      "name": "secretsmanager-gen-secret",
      "kind": "lifecycle",
      "setup": [],
      "tests": [
        {
          "name": "CreateSecret",
          "op": "CreateSecret",
          "call": {
            "op": "CreateSecret",
            "params": {
              "Description": "compat scenario secret",
              "Name": {
                "$name": "s"
              },
              "SecretString": "compat-scenario-initial"
            },
            "export": {
              "secret.arn": "$.ARN"
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.ARN": {
                  "nonEmpty": true
                }
              }
            },
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "DescribeSecret",
                  "params": {
                    "SecretId": {
                      "$ref": "secret.arn"
                    }
                  }
                },
                "checks": {
                  "$.ARN": {
                    "equals": {
                      "$ref": "secret.arn"
                    }
                  },
                  "$.Description": {
                    "equals": "compat scenario secret"
                  }
                }
              }
            },
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "listContains",
                "call": {
                  "op": "ListSecrets",
                  "params": {
                    "Filters": [
                      {
                        "Key": "name",
                        "Values": [
                          {
                            "$name": "s"
                          }
                        ]
                      }
                    ]
                  }
                },
                "itemsPath": "$.SecretList",
                "where": {
                  "$.ARN": {
                    "$ref": "secret.arn"
                  }
                }
              }
            }
          ]
        },
        {
          "name": "DescribeSecret",
          "op": "DescribeSecret",
          "call": {
            "op": "DescribeSecret",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.ARN": {
                  "equals": {
                    "$ref": "secret.arn"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "UpdateSecret",
          "op": "UpdateSecret",
          "call": {
            "op": "UpdateSecret",
            "params": {
              "Description": "compat scenario secret, updated",
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "DescribeSecret",
                  "params": {
                    "SecretId": {
                      "$ref": "secret.arn"
                    }
                  }
                },
                "checks": {
                  "$.Description": {
                    "equals": "compat scenario secret, updated"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "TagResource",
          "op": "TagResource",
          "call": {
            "op": "TagResource",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              },
              "Tags": [
                {
                  "Key": "compat",
                  "Value": "scenario"
                }
              ]
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "listContains",
                "call": {
                  "op": "DescribeSecret",
                  "params": {
                    "SecretId": {
                      "$ref": "secret.arn"
                    }
                  }
                },
                "itemsPath": "$.Tags",
                "where": {
                  "$.Key": "compat",
                  "$.Value": "scenario"
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "UntagResource",
          "op": "UntagResource",
          "call": {
            "op": "UntagResource",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              },
              "TagKeys": [
                "compat"
              ]
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "absent",
                "call": {
                  "op": "DescribeSecret",
                  "params": {
                    "SecretId": {
                      "$ref": "secret.arn"
                    }
                  }
                },
                "itemsPath": "$.Tags",
                "where": {
                  "$.Key": "compat"
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "GetRandomPassword",
          "op": "GetRandomPassword",
          "call": {
            "op": "GetRandomPassword",
            "params": {
              "ExcludePunctuation": true,
              "PasswordLength": 24
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.RandomPassword": {
                  "matches": "^[A-Za-z0-9]{24}$"
                }
              }
            }
          ]
        },
        {
          "name": "BatchGetSecretValue",
          "op": "BatchGetSecretValue",
          "call": {
            "op": "BatchGetSecretValue",
            "params": {
              "SecretIdList": [
                {
                  "$ref": "secret.arn"
                }
              ]
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.SecretValues",
              "where": {
                "$.ARN": {
                  "$ref": "secret.arn"
                },
                "$.SecretString": "compat-scenario-initial"
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "ValidateResourcePolicy",
          "op": "ValidateResourcePolicy",
          "call": {
            "op": "ValidateResourcePolicy",
            "params": {
              "ResourcePolicy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::123456789012:root\"},\"Action\":\"secretsmanager:GetSecretValue\",\"Resource\":\"*\"}]}",
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.PolicyValidationPassed": {
                  "equals": true
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "PutResourcePolicy",
          "op": "PutResourcePolicy",
          "call": {
            "op": "PutResourcePolicy",
            "params": {
              "ResourcePolicy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::123456789012:root\"},\"Action\":\"secretsmanager:GetSecretValue\",\"Resource\":\"*\"}]}",
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "GetResourcePolicy",
                  "params": {
                    "SecretId": {
                      "$ref": "secret.arn"
                    }
                  }
                },
                "checks": {
                  "$.ARN": {
                    "equals": {
                      "$ref": "secret.arn"
                    }
                  },
                  "$.ResourcePolicy": {
                    "matches": "secretsmanager:GetSecretValue"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "GetResourcePolicy",
          "op": "GetResourcePolicy",
          "call": {
            "op": "GetResourcePolicy",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.ARN": {
                  "equals": {
                    "$ref": "secret.arn"
                  }
                },
                "$.ResourcePolicy": {
                  "matches": "secretsmanager:GetSecretValue"
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "DeleteResourcePolicy",
          "op": "DeleteResourcePolicy",
          "call": {
            "op": "DeleteResourcePolicy",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "GetResourcePolicy",
                  "params": {
                    "SecretId": {
                      "$ref": "secret.arn"
                    }
                  }
                },
                "checks": {
                  "$.ResourcePolicy": {
                    "missing": true
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "CancelRotateSecret",
          "op": "CancelRotateSecret",
          "call": {
            "op": "CancelRotateSecret",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.ARN": {
                  "equals": {
                    "$ref": "secret.arn"
                  }
                },
                "$.Name": {
                  "equals": {
                    "$name": "s"
                  }
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "ListSecrets",
          "op": "ListSecrets",
          "call": {
            "op": "ListSecrets",
            "params": {
              "Filters": [
                {
                  "Key": "name",
                  "Values": [
                    {
                      "$name": "s"
                    }
                  ]
                }
              ]
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.SecretList",
              "where": {
                "$.ARN": {
                  "$ref": "secret.arn"
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        },
        {
          "name": "DeleteSecret",
          "op": "DeleteSecret",
          "call": {
            "op": "DeleteSecret",
            "params": {
              "ForceDeleteWithoutRecovery": true,
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "eventually",
              "maxAttempts": 10,
              "delayMs": 1000,
              "assert": {
                "kind": "absent",
                "call": {
                  "op": "DescribeSecret",
                  "params": {
                    "SecretId": {
                      "$ref": "secret.arn"
                    }
                  }
                },
                "error": {
                  "shape": "ResourceNotFoundException",
                  "code": "ResourceNotFoundException"
                }
              }
            }
          ],
          "depends": [
            "CreateSecret"
          ]
        }
      ],
      "teardown": [
        {
          "op": "DeleteSecret",
          "params": {
            "ForceDeleteWithoutRecovery": true,
            "SecretId": {
              "$ref": "secret.arn"
            }
          }
        }
      ]
    },
    {
      "name": "secretsmanager-gen-version",
      "kind": "lifecycle",
      "setup": [
        {
          "op": "CreateSecret",
          "params": {
            "Description": "compat scenario secret",
            "Name": {
              "$name": "s"
            },
            "SecretString": "compat-scenario-initial"
          },
          "export": {
            "secret.arn": "$.ARN"
          }
        }
      ],
      "tests": [
        {
          "name": "PutSecretValue",
          "op": "PutSecretValue",
          "call": {
            "op": "PutSecretValue",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              },
              "SecretString": "compat scenario version value"
            },
            "export": {
              "version.id": "$.VersionId"
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.VersionId": {
                  "nonEmpty": true
                }
              }
            },
            {
              "kind": "readback",
              "call": {
                "op": "GetSecretValue",
                "params": {
                  "SecretId": {
                    "$ref": "secret.arn"
                  },
                  "VersionId": {
                    "$ref": "version.id"
                  }
                }
              },
              "checks": {
                "$.VersionId": {
                  "equals": {
                    "$ref": "version.id"
                  }
                }
              }
            },
            {
              "kind": "listContains",
              "call": {
                "op": "ListSecretVersionIds",
                "params": {
                  "SecretId": {
                    "$ref": "secret.arn"
                  }
                }
              },
              "itemsPath": "$.Versions",
              "where": {
                "$.VersionId": {
                  "$ref": "version.id"
                }
              }
            }
          ]
        },
        {
          "name": "GetSecretValue",
          "op": "GetSecretValue",
          "call": {
            "op": "GetSecretValue",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              },
              "VersionId": {
                "$ref": "version.id"
              }
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.VersionId": {
                  "equals": {
                    "$ref": "version.id"
                  }
                }
              }
            }
          ],
          "depends": [
            "PutSecretValue"
          ]
        },
        {
          "name": "UpdateSecretVersionStage",
          "op": "UpdateSecretVersionStage",
          "call": {
            "op": "UpdateSecretVersionStage",
            "params": {
              "MoveToVersionId": {
                "$ref": "version.id"
              },
              "SecretId": {
                "$ref": "secret.arn"
              },
              "VersionStage": "COMPATSCENARIO"
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.ARN": {
                  "equals": {
                    "$ref": "secret.arn"
                  }
                }
              }
            },
            {
              "kind": "readback",
              "call": {
                "op": "GetSecretValue",
                "params": {
                  "SecretId": {
                    "$ref": "secret.arn"
                  },
                  "VersionStage": "COMPATSCENARIO"
                }
              },
              "checks": {
                "$.SecretString": {
                  "equals": "compat scenario version value"
                },
                "$.VersionId": {
                  "equals": {
                    "$ref": "version.id"
                  }
                }
              }
            }
          ],
          "depends": [
            "PutSecretValue"
          ]
        },
        {
          "name": "ListSecretVersionIds",
          "op": "ListSecretVersionIds",
          "call": {
            "op": "ListSecretVersionIds",
            "params": {
              "SecretId": {
                "$ref": "secret.arn"
              }
            }
          },
          "assert": [
            {
              "kind": "listContains",
              "itemsPath": "$.Versions",
              "where": {
                "$.VersionId": {
                  "$ref": "version.id"
                }
              }
            }
          ],
          "depends": [
            "PutSecretValue"
          ]
        }
      ],
      "teardown": [
        {
          "op": "DeleteSecret",
          "params": {
            "ForceDeleteWithoutRecovery": true,
            "SecretId": {
              "$ref": "secret.arn"
            }
          }
        }
      ]
    }
  ]
}
