        {
          "name": "CreatePolicy",
          "op": "CreatePolicy",
          "call": {
            "op": "CreatePolicy",
            "params": {
              "Content": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"}]}",
              "Description": "compat scenario policy",
              "Name": {
                "$name": "policy"
              },
              "Type": "SERVICE_CONTROL_POLICY"
            },
            "export": {
              "policy.arn": "$.Policy.PolicySummary.Arn",
              "policy.id": "$.Policy.PolicySummary.Id"
            }
          },
          "assert": [
            {
              "kind": "responseField",
              "checks": {
                "$.Policy.PolicySummary.Arn": {
                  "matches": "^(arn:aws:organizations::\\d{12}:policy\\/o-[a-z0-9]{10,32}\\/[0-9a-z_]+\\/p-[0-9a-z]{10,32})|(arn:aws:organizations::aws:policy\\/[0-9a-z_]+\\/p-[0-9a-zA-Z_]{10,128})$"
                },
                "$.Policy.PolicySummary.Id": {
                  "matches": "^p-[0-9a-zA-Z_]{8,128}$"
                }
              }
            },
            {
              "kind": "readback",
              "call": {
                "op": "DescribePolicy",
                "params": {
                  "PolicyId": {
                    "$ref": "policy.id"
                  }
                }
              },
              "checks": {
                "$.Policy.PolicySummary.Description": {
                  "equals": "compat scenario policy"
                },
                "$.Policy.PolicySummary.Id": {
                  "equals": {
                    "$ref": "policy.id"
                  }
                }
              }
            },
            {
              "kind": "listContains",
              "call": {
                "op": "ListPolicies",
                "params": {
                  "Filter": "SERVICE_CONTROL_POLICY"
                }
              },
              "itemsPath": "$.Policies",
              "where": {
                "$.Id": {
                  "$ref": "policy.id"
                }
              }
            }
          ]
        },
        {
