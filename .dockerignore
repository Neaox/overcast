# Ignore everything, then allowlist only what the build needs.
*

# ---- Go builder (stage 2) ---------------------------------------------------
# The docs index is committed, so it arrives with !internal/ and !web/ below —
# scripts/docs-index.go no longer needs to be in the build context.
!go.mod
!go.sum
!embed.go
!embed_slim.go
!cmd/
!internal/
!docs/
!docs/*.md
!docs/cdk/
!docs/cdk/**
!docs/services/
!docs/services/**

# ---- Web builder (stage 1) --------------------------------------------------
!web/
# npm ci runs inside the container — host node_modules are dead weight (~800 MB).
web/node_modules/
web/api/node_modules/
# Build outputs that may exist locally.
web/dist/
web/dist-server/

# ---- Console stage (stage 5) ------------------------------------------------
!docker/
