{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash scripts/hooks/commit-self-review-reminder.sh",
            "timeout": 10,
            "statusMessage": "Self-review reminder"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash scripts/verify-changed.sh",
            "timeout": 900,
            "statusMessage": "Verifying changed code before push (golangci-lint / pnpm typecheck)"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash scripts/hooks/duplicate-work-warning.sh",
            "timeout": 30,
            "statusMessage": "Checking whether this issue is already claimed"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash scripts/hooks/duplicate-work-warning.sh",
            "timeout": 30,
            "statusMessage": "Checking whether this issue is already claimed"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/pr-checks-poll-loop-warning.sh",
            "timeout": 10,
            "statusMessage": "Checking for a hand-rolled CI poll loop"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/reject-worktree-stash.sh",
            "timeout": 10,
            "statusMessage": "Protecting the shared worktree stash"
          }
        ]
      }
    ]
  }
}
