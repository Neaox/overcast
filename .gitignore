coverage.out
coverage.html

# git worktrees
.worktrees/

# compiled binaries
bin/
# stray root-level binaries from `go build ./cmd/...` without -o
/overcast
/overcastd
# any stray root-level .exe (ad-hoc Windows cross-compile tests, etc.)
/*.exe

# go test binaries (from `go test -c`) and profiler outputs
*.test
*.prof
*.pprof
*.trace

# air hot-reload output
tmp/

# persistent state (dev container data dir — survives rebuilds, not for VCS)
.overcast/
# git worktrees (must live outside the repo; ignore any stray ones inside)
.worktrees/
.devcontainer/.env
.devcontainer/docker-compose.yaml

# compat dashboard — last run results (persisted across server restarts, not for VCS)
compat-results.json
# compat agent-friendly text report (regenerated after every run, not for VCS)
compat-report.txt

# The docs nav/search index (web/src/docs-nav.gen.ts,
# internal/docssearch/index.gen.jsonl) is generated by scripts/docs-index.go but
# deliberately NOT ignored: its importers cannot compile without it, and a bare
# `git clone && go build ./...` must work with only the Go toolchain. Staleness
# is caught by `docs-index.go --check` (run from `make docs-check`), the same
# way internal/capabilities/all.gen.go is handled. Both artifacts are
# document-major — one line or one object per doc — so a docs edit rewrites
# only that doc's entry and branches that touch different docs merge cleanly.

# log files
*.log
logs.txt

# node_modules (root-level catch-all for any suites without their own .gitignore)
**/node_modules/

# mkcert TLS certificates (generated by vite-plugin-mkcert for HTTPS dev server)
.cert/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

.cache
.npm
.claude/launch.json

# Python bytecode from the helper scripts in scripts/ and the python-sdk suite.
__pycache__/
*.py[cod]

# Compat report renderings — regenerated by scripts/compat-report.py.
compat-junit.xml
compat-comment.md

# Flake detection findings — regenerated by scripts/compat-flake-detect.py.
flake-findings.json
flake-run-*.json
scripts/seed*.*
