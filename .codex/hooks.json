{
  "description": "Repository guardrails mirrored from the Claude Code hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-pre-tool-use.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)\\scripts\\hooks\\run-git-bash.ps1\" -ScriptPath \"$(git rev-parse --show-toplevel)\\scripts\\hooks\\codex-pre-tool-use.sh\"",
            "timeout": 900,
            "statusMessage": "Checking repository shell guardrails"
          }
        ]
      }
    ]
  }
}
